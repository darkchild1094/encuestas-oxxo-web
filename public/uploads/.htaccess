# Carpeta de archivos subidos por usuarios (fotos de perfil). Aqui NUNCA
# debe ejecutarse codigo: si alguien logra colar un .php disfrazado de
# imagen, esto evita que el servidor lo interprete.
#
# OJO: nada de "php_flag" / "php_value" aqui. Este hosting corre PHP por
# FPM (existe .user.ini), no mod_php, y esas directivas en .htaccess
# tumban toda la carpeta con Error 500 (por eso dejaron de verse las
# fotos). Basta con negar el acceso a las extensiones ejecutables.

Options -ExecCGI -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "\.(?i:php|phtml|phar|pht|php[0-9]|phps|pl|py|cgi|sh|lua|asp|aspx|jsp)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|pht|php3|php4|php5|php7|phps|pl|py|cgi|sh|asp|aspx|jsp)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Desactiva mod_php SOLO si de verdad esta cargado (en FPM este bloque
# simplemente se ignora, no da error).
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_admin_flag engine off
</IfModule>
